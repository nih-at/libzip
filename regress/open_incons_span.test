# zip_open: entries must cover the archive without gaps or overlaps
program tryopen
file incons-gap-entries.zzip incons-gap-entries.zip
file incons-gap-start.zzip incons-gap-start.zip
file incons-entry-overlaps-cd.zzip incons-entry-overlaps-cd.zip
file incons-descriptor-overlap.zzip incons-descriptor-overlap.zip
file descriptor.zzip descriptor.zip
file descriptor-signature.zzip descriptor-signature.zip
file descriptor-zip64.zzip descriptor-zip64.zip
file descriptor-zip64-nosig.zzip descriptor-zip64-nosig.zip
arguments -s -c incons-gap-entries.zzip incons-gap-start.zzip incons-entry-overlaps-cd.zzip incons-descriptor-overlap.zzip descriptor.zzip descriptor-signature.zzip descriptor-zip64.zzip descriptor-zip64-nosig.zzip
return 1
