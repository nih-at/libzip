# zip_fseek: a full, contiguous read of a WinZip AES entry still catches a
# tampered authentication code, even though the entry is now seekable
features HAVE_CRYPTO
return 1
arguments encrypt.zzip  set_password foofoofoo  fopen encrypted  fseek 0 0 set  fread 0 10
file encrypt.zzip encrypt-aes128-bad-hmac.zip
stdout
opened 'encrypted' as file 0
encrypted
end-of-inline-data
