# zip_open: files with overlapping entries are inconsistent
program tryopen
file incons-overlap.zzip incons-overlap.zip
file incons-overlap-shared-data.zzip incons-overlap-shared-data.zip
arguments -s -c incons-overlap.zzip incons-overlap-shared-data.zzip
return 1
