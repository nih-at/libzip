# zip_open: a Zip64 EOCD whose central directory offset + size wraps
# around must be rejected, not silently accepted because the sum
# overflowed.
program tryopen
arguments -s test.zzip
file test.zzip incons-eocd64-cdir-overflow.zip
return 1
stdout
opening 'test.zzip' returned error Seek error: File too large
